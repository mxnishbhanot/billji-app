{
  "expo": {
    "name": "Billji",
    "slug": "billji-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "billji",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "ios": {
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.billji.mobile",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Billji needs photo library access so you can choose a business logo."
      }
    },
    "android": {
      "package": "com.billji.mobile",
      "googleServicesFile": "./google-services.json",
      "versionCode": 1,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FC7A0E"
      },
      "predictiveBackGestureEnabled": true
    },
    "plugins": [
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      "expo-sharing",
      "@react-native-community/datetimepicker",
      "@react-native-firebase/app",
      "@react-native-google-signin/google-signin",
      [
        "@sentry/react-native/expo",
        {
          "organization": "REPLACE_WITH_SENTRY_ORG",
          "project": "REPLACE_WITH_SENTRY_PROJECT"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "${EXPO_PUBLIC_API_BASE_URL}",
      "eas": {
        "projectId": "5e946fc2-16ed-4aa0-af9d-d6f61ea09c3b"
      }
    },
    "owner": "billji.dev"
  }
}
